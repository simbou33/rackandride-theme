{% comment %}
  Rack And Ride — Barre de progression « livraison offerte »
  Affichée dans le cart drawer. Pilotée par settings.rar_free_shipping_threshold (€).
  Seuil à 0 = masquée. Se re-render avec le drawer (#CartDrawer) à chaque MAJ panier.

  Usage : {% render 'rar-free-shipping-bar' %}
{% endcomment %}

{%- liquid
  assign threshold = settings.rar_free_shipping_threshold | default: 0
  if threshold > 0
    assign threshold_cents = threshold | times: 100
    assign current = cart.total_price
    assign remaining = threshold_cents | minus: current
    assign pct = current | times: 100 | divided_by: threshold_cents
    if pct > 100
      assign pct = 100
    endif
    assign remaining_money = remaining | money
  endif
-%}

{%- if threshold > 0 -%}
  <div
    class="rar-shipping-bar{% if remaining <= 0 %} rar-shipping-bar--done{% endif %}"
    aria-live="polite"
  >
    <p class="rar-shipping-bar__text">
      <span class="rar-shipping-bar__icon svg-wrapper">{{- 'icon-truck.svg' | inline_asset_content -}}</span>
      {%- if remaining > 0 -%}
        {{ 'sections.cart.free_shipping_progress_html' | t: amount: remaining_money }}
      {%- else -%}
        {{ 'sections.cart.free_shipping_unlocked_html' | t }}
      {%- endif -%}
    </p>
    <div class="rar-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}">
      <div class="rar-progress__bar" style="width: {{ pct }}%;"></div>
    </div>
  </div>
{%- endif -%}
