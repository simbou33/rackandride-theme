{%- liquid
  assign _v = product.selected_or_first_available_variant
  assign _img = product.featured_media | image_url: width: 1200
  assign _col = product.collections | first
  assign _rating_value = product.metafields.reviews.rating.value.rating
  assign _rating_count = product.metafields.reviews.rating_count
  assign _rating_max   = product.metafields.reviews.rating.value.scale_max | default: 5
  assign _availability = 'OutOfStock'
  if _v.available
    assign _availability = 'InStock'
  endif
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ canonical_url | json }},
  "description": {{ product.description | strip_html | truncate: 500 | strip | json }},
  "sku": {{ _v.sku | default: product.id | json }},
  "brand": { "@type": "Brand", "name": "Rack And Ride" }
  {%- if product.featured_media -%}
  ,"image": {{ _img | prepend: 'https:' | json }}
  {%- endif -%}
  ,"offers": {
    "@type": "Offer",
    "url": {{ canonical_url | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ _v.price | divided_by: 100.0 | json }},
    "availability": "https://schema.org/{{ _availability }}",
    "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
  }
  {%- if _rating_value != blank and _rating_count != blank -%}
  ,"aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ _rating_value | json }},
    "reviewCount": {{ _rating_count | json }},
    "bestRating": {{ _rating_max | json }},
    "worstRating": 1
  }
  {%- endif -%}
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": {{ 'general.breadcrumbs.home' | t | json }},
      "item": {{ shop.url | json }}
    }
    {%- if _col -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ _col.title | json }},
      "item": {{ _col.url | prepend: shop.url | json }}
    }
    ,{
      "@type": "ListItem",
      "position": 3,
      "name": {{ product.title | json }}
    }
    {%- else -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ product.title | json }}
    }
    {%- endif -%}
  ]
}
</script>
