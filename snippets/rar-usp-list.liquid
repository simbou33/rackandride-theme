<ul class="rar-usp-list" {{ block.shopify_attributes }}>
  {%- for i in (1..5) -%}
    {%- liquid
      case i
        when 1
          assign _icon_default = 'bolt'
          assign _text_default = 'sections.main-product.blocks.usp_list.defaults.item_1' | t
        when 2
          assign _icon_default = 'leaf'
          assign _text_default = 'sections.main-product.blocks.usp_list.defaults.item_2' | t
        when 3
          assign _icon_default = 'shield'
          assign _text_default = 'sections.main-product.blocks.usp_list.defaults.item_3' | t
        when 4
          assign _icon_default = 'layers'
          assign _text_default = 'sections.main-product.blocks.usp_list.defaults.item_4' | t
        when 5
          assign _icon_default = 'ruler'
          assign _text_default = 'sections.main-product.blocks.usp_list.defaults.item_5' | t
      endcase
      assign icon_key = 'item_' | append: i | append: '_icon'
      assign text_key = 'item_' | append: i | append: '_text'
      assign _icon = block.settings[icon_key] | default: _icon_default
      assign _text = block.settings[text_key] | default: _text_default
    -%}
    {%- if _text != blank -%}
      <li class="rar-usp-list__item">
        <span class="rar-usp-list__icon" aria-hidden="true">
          {%- case _icon -%}
            {%- when 'bolt' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            {%- when 'leaf' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
            {%- when 'shield' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            {%- when 'layers' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
            {%- when 'ruler' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><path d="M21.3 8.7 8.7 21.3c-1 1-2.5 1-3.4 0l-2.6-2.6c-1-1-1-2.5 0-3.4L15.3 2.7c1-1 2.5-1 3.4 0l2.6 2.6c1 1 1 2.5 0 3.4z"/><path d="m7.5 10.5 2 2"/><path d="m10.5 7.5 2 2"/><path d="m13.5 4.5 2 2"/><path d="m4.5 13.5 2 2"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><polyline points="20 6 9 17 4 12"/></svg>
          {%- endcase -%}
        </span>
        <span class="rar-usp-list__text">{{ _text }}</span>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
