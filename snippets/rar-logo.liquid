{% comment %}
  Rack And Ride — logo SVG inline.
  Fond clair → logo-rackandride-noir.svg (currentColor hérite de --color-foreground = Encre).
  Taille pilotée par settings.logo_width (défaut 90 px).
  Usage : {% render 'rar-logo' %}
{% endcomment %}
{%- assign rar_logo_w = settings.logo_width | default: 90 -%}
<span class="rar-logo header__heading-logo motion-reduce" role="img" aria-label="{{ 'general.brand.logo_alt' | t }}" style="width: {{ rar_logo_w }}px;">
  {{- 'logo-rackandride-noir.svg' | inline_asset_content -}}
</span>
