<div class="rar-trust-badges-section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- render 'rar-trust-badges' -%}
  </div>
</div>

{% schema %}
{
  "name": "Trust badges",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "scheme-1", "label": "t:sections.all.color_scheme.options__1.label" },
        { "value": "scheme-2", "label": "t:sections.all.color_scheme.options__2.label" },
        { "value": "scheme-3", "label": "t:sections.all.color_scheme.options__3.label" },
        { "value": "scheme-4", "label": "t:sections.all.color_scheme.options__4.label" },
        { "value": "scheme-5", "label": "t:sections.all.color_scheme.options__5.label" }
      ],
      "default": "scheme-2",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 80, "step": 4, "unit": "px",
      "label": "t:sections.all.padding_top.label",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 80, "step": 4, "unit": "px",
      "label": "t:sections.all.padding_bottom.label",
      "default": 28
    }
  ],
  "presets": [
    { "name": "Trust badges" }
  ]
}
{% endschema %}
